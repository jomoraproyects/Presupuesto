# Sitio separado de seleccion en el puerto 8443. Agregar `Listen 8443` una
# sola vez en ports.conf y reutilizar el certificado correcto para la IP.
<VirtualHost *:8443>
    ServerName 192.168.100.251
    DocumentRoot /home/serviciudad/Escritorio/presupuesto/frontend/dist

    SSLEngine on
    SSLCertificateFile /RUTA/AL/CERTIFICADO.crt
    SSLCertificateKeyFile /RUTA/A/LA/CLAVE.key

    <Directory /home/serviciudad/Escritorio/presupuesto/frontend/dist>
        Options -Indexes
        AllowOverride None
        Require all granted
        FallbackResource /index.html
    </Directory>

    ProxyRequests Off
    ProxyPreserveHost On
    ProxyPass /api/ http://127.0.0.1:8081/api/
    ProxyPassReverse /api/ http://127.0.0.1:8081/api/

</VirtualHost>
