# Usar un nombre DNS interno distinto al de seleccion. Sustituir los valores
# de certificado y dominio conforme a la configuracion existente de Nginx.
server {
    listen 443 ssl;
    server_name presupuesto.interno.empresa.com;

    ssl_certificate /RUTA/AL/CERTIFICADO.crt;
    ssl_certificate_key /RUTA/A/LA/CLAVE.key;

    root /var/www/presupuesto-web;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
