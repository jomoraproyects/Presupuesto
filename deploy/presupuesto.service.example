[Unit]
Description=Presupuesto Serviciudad
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=exec
User=serviciudad
Group=serviciudad
WorkingDirectory=/home/serviciudad/Escritorio/presupuesto
EnvironmentFile=/home/serviciudad/Escritorio/presupuesto/.env.production
ExecStart=/home/serviciudad/Escritorio/presupuesto/.local/jdk/runtime/bin/java -jar /home/serviciudad/Escritorio/presupuesto/target/presupuesto-0.1.0-SNAPSHOT.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
